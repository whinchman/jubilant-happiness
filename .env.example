# Copy to .env and fill in. docker-compose and the server both read this file.

# Anthropic API key — powers the AI task breakdown.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use for breakdowns (default: claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Session cookie encryption secret — use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: shared invite token for /auth/setup. When set, anyone signing up has to enter it —
# share the token with the friends you want to invite. Leave empty to allow open signups (fine
# for local dev).
SETUP_TOKEN=
